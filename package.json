{
  "name": "feishu-tabs",
  "version": "1.0.0",
  "description": "飞书/Lark 多账号容器：单窗口 + 原生菜单 + WebContentsView 隔离",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.you.feishu-tabs",
    "productName": "飞书多账号",
    "files": [
      "main.js",
      "prompt-dialog.js",
      "accounts.json",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "locales": ["zh-CN", "en-US"],
    "portable": {
      "artifactName": "飞书多账号-${version}-portable.exe"
    }
  }
}
